# Copy to .env and fill in. Never commit .env.
# Reproducing the papers from committed results (make reproduce-v3) needs none of these.

# API keys, for live runs only (cached replays need none).
OPENAI_API_KEY=
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# The v3 second answer model (Llama 3.3 70B) runs through OpenRouter. Warning: mem0 2.1.0 silently sends its own
# OpenAI calls to OpenRouter whenever this is set; bench/run.py removes it from mem0's process (paper Appendix G).
OPENROUTER_API_KEY=

# Optional overrides (defaults in src/engram/config.py).
TYPESAFE_MODEL=
ENGRAM_EXTRACT_MODEL=
ENGRAM_LLM_MODEL=
ENGRAM_LLM_ATTEMPTS=
ENGRAM_JEV_MAX_RPS=
ENGRAM_EMBED_DEVICE=
ENGRAM_DB=
ENGRAM_LOG=
ENGRAM_LLM_LOG=

# Benchmark harness (defaults in bench/run.py).
BENCH_CONCURRENCY=
BENCH_OPENAI_RETRIES=

# Graphiti (v2 exploratory arm only).
NEO4J_URI=
NEO4J_PASSWORD=

# Set by the bench code itself; listed for completeness.
MEM0_TELEMETRY=
TOKENIZERS_PARALLELISM=
